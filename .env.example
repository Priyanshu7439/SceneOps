SCENEOPS_VLLM_BASE_URL=http://127.0.0.1:8081/v1
# The llama.cpp server advertises the loaded GGUF ID. "auto" resolves it when
# the provider exposes exactly one model; set the exact ID for multi-model use.
SCENEOPS_VLLM_MODEL=auto
# Optional; leave unset for same-origin/local development.
SCENEOPS_CORS_ORIGINS=http://localhost:5173
# Optional W&B mode: disabled, offline, or online.
SCENEOPS_WANDB_MODE=disabled
